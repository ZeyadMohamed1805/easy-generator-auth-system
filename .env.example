# MongoDB (docker compose)
MONGO_PORT=27017
MONGO_INITDB_ROOT_USERNAME=easygen
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_INITDB_DATABASE=easy_generator_auth

# API
NODE_ENV=development
PORT=3000
API_PORT=3000
WEB_PORT=8080
MONGODB_URI=mongodb://easygen:changeme@localhost:27017/easy_generator_auth?authSource=admin
JWT_ACCESS_SECRET=change-me-to-a-long-random-string-min-32-chars
JWT_ACCESS_TTL_SECONDS=900
REFRESH_TOKEN_TTL_DAYS=7
COOKIE_SECURE=false
AUTH_THROTTLE_TTL_MS=60000
AUTH_THROTTLE_LIMIT=10
